<Window x:Class="WpfApp1.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WpfApp1"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800" x:Name="root">
  
    <StackPanel>
        <TextBox Width="200" Height="100" VerticalAlignment="Center" 
                 HorizontalAlignment="Center"
                 Text="{Binding ElementName=root, Path=AbsName, Mode=Default}"  />
        <Button Style="{StaticResource btnStyle}" Width="200" Height="100" Margin="10" Content="更改属性值"
                Click="Button_Click"/>

        <Button Width="200" Height="100" Margin="10" Content="获取属性值"
        Click="Button_Click_1"/>

        <!--<Button Width="200" Height="50" Margin="10" Content="测试按钮" Background="YellowGreen" BorderBrush="Blue">
            <Button.Template>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="bor" BorderBrush="{TemplateBinding BorderBrush}" CornerRadius="20" BorderThickness="5" Background="{TemplateBinding Background}">
                        --><!--<ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center"/>--><!--
                        <TextBox Text="{TemplateBinding Content}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>

                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bor" Property="Background" Value="Black"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Button.Template>
        </Button>-->

        <Button Width="200" Height="50" Content="测试按钮" Margin="10" Background="YellowGreen" BorderBrush="blue">
            <Button.Template>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="bor" BorderBrush="{TemplateBinding BorderBrush}" Background="{TemplateBinding Background}" BorderThickness="5"
                            CornerRadius="20">
                        <TextBox Text="{TemplateBinding Content}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>

                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bor" Property="Background" Value="Black"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Button.Template>
        </Button>
    </StackPanel>
</Window>
